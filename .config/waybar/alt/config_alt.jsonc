// -*- mode: jsonc -*-
//  
{
    //"layer": "down", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 0, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "custom/laucher",
        "niri/workspaces",
        "custom/left#1",
        "network",
        "custom/right#1"

        //"custom/media"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "custom/waybar_menu",
        //"mpd",
        //"idle_inhibitor",
        //"pulseaudio",
        //"power-profiles-daemon",
        //"custom/power-profile",
        "custom/left#2",
        "cpu",
        "memory",
        "disk",
        "temperature",
        "custom/right#2",
        //"backlight",
        //"keyboard-state",
        //"sway/language",
        
        "custom/left#3",
        "battery",
        "clock",
        "custom/right#3",

        //"battery#bat0",
        //"clock",
        //"tray",
        "custom/power"
        ],
    //Modules configuration
     "niri/workspaces": {
         "disable-scroll": true,
         "all-outputs": true,
         "warp-on-scroll": false,
         "format": "{icon}",
         "format-icons": {
             "1": "",
             "2": "",
             "3": "",
             "4": "",
             "5": "",
             "urgent": "",
             "focused": "󰮯",
             "default": "󰊠"
         }
     },
    //"keyboard-state": {
    //    "numlock": true,
    //    "capslock": true,
    //    "format": "{name} {icon}",
    //    "format-icons": {
    //        "locked": "",
    //        "unlocked": ""
    //    }
    //},
    "clock": {
        // "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y/%m/%d}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "tooltip-format": "hello",
        "tooltip": true,
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    //"battery#bat0": {
    //    "bat": "BAT0"
    //},
    //"power-profiles-daemon": {
    //  "format": "{icon}",
    //  "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    //  "tooltip": true,
    //  "on-click" : "true",
    //  "format-icons": {
    //    "default": "",
    //    "performance": "",
    //   "balanced": "",
    //    "power-saver": ""
    //  }
    //},
    //"network": {
    //    // "interface": "wlp2*", // (Optional) To force the use of this interface
    //    "format-wifi": "{essid} ({signalStrength}%) ",
    //    "format-ethernet": "{ipaddr}/{cidr} ",
    //    "tooltip-format": "{ifname} via {gwaddr} ",
    //    "format-linked": "{ifname} (No IP) ",
    //    "format-disconnected": "Disconnected ⚠",
    //    "format-alt": "{ifname}: {ipaddr}/{cidr}"
    //},
    "network": {
      "format": "U{bandwidthUpBytes} D{bandwidthDownBytes}",
      "tooltip-format": "{ifname} {gwaddr} ({signalStrength}%)",
      "format-linked": "{ifname} (No IP) ",
      "format-disconnected": "Disconnected ⚠",
      "interval": 5
    },
    "custom/power": {
        "format" : "⏻ ",
		    "tooltip": false,
		    "menu": "on-click",
		    "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate",
      "exit": "niri msg action quit"
		}
    },
     "custom/laucher": {
      "format": "  ",
      "on-click": "fuzzel"
    },
    "custom/waybar_menu": {
      "format": "󰕮 ",
      "on-click": "ags toggle menuwaybar",
      "tooltip": true,
      "tooltip-format": "menu waybar"
    },
    "disk": {
	    "interval": 60,
	    "format": "{percentage_used}% ",
	    "header": "Disks: ",
	    "paths": ["/", "/home"],
	    "separator": " ",
      "on-click": "thunar"
    },
    "custom/right#1": {
      "format": "",
      "tooltip": false
    },
    "custom/left#1": {
      "format": "",
      "tooltip": false
    },
    "custom/right#2": {
      "format": "",
      "tooltip": false
    },
    "custom/left#2": {
      "format": "",
      "tooltip": false
    },
    "custom/right#3": {
      "format": "",
      "tooltip": false
    },
    "custom/left#3": {
      "format": "",
      "tooltip": false
    }
}
